<Window x:Class="Keuangan.Launcher.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keuangan - Setup Awal" Height="660" Width="640"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <!-- Pola ScrollViewer+tombol-di-baris-terpisah PERSIS SetupWizardWindow.xaml
         DataMaster.Launcher (bug fatal nyata dijelaskan di sana - jangan
         diulangi: konten variabel TIDAK BOLEH bisa mendorong tombol Lanjutkan
         keluar area jendela yang terlihat). -->
    <Grid Margin="32,32,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,-24,0">
            <StackPanel Margin="0,0,24,0">
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Cara pakai PC ini" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Pilihan ini ditanyakan saat pertama kali dibuka. Bisa diubah lagi kapan saja lewat tombol 'Ganti Pengaturan Jaringan' di pojok jendela utama." FontSize="12" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <RadioButton x:Name="RbDeveloper" Content="Developer (testing - tanpa login, ganti role bebas)" FontWeight="SemiBold" FontSize="14" IsChecked="True" Checked="ModePilihan_Changed" Margin="0,0,0,4"/>
                    <TextBlock Text="TIDAK untuk pemakaian sungguhan sekolah - dipakai developer/IT internal utk mencoba semua role tanpa perlu bikin akun." FontSize="12" Foreground="#6B7280" Margin="24,0,0,16" TextWrapping="Wrap"/>

                    <RadioButton x:Name="RbServer" Content="PC ini jadi SERVER (data keuangan sungguhan, wajib login)" FontWeight="SemiBold" FontSize="14" Checked="ModePilihan_Changed" Margin="0,0,0,4"/>
                    <TextBlock Text="Pilih ini di 1 PC saja (yang paling jarang dimatikan) - database sungguhan ada di PC ini. PC lain di jaringan yang sama bisa menampilkan data dari PC ini (opsional)." FontSize="12" Foreground="#6B7280" Margin="24,0,0,16" TextWrapping="Wrap"/>

                    <RadioButton x:Name="RbKlien" Content="PC ini ikut PC lain (klien)" FontWeight="SemiBold" FontSize="14" Checked="ModePilihan_Changed" Margin="0,0,0,4"/>
                    <TextBlock Text="Pilih ini kalau ada PC lain yang sudah diatur sebagai 'Server' - PC ini tidak punya database sendiri, cuma menampilkan data PC server." FontSize="12" Foreground="#6B7280" Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border x:Name="BorderDetail" Background="#F3F4F6" CornerRadius="8" Padding="16" Margin="0,0,0,16" VerticalAlignment="Top" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel x:Name="PanelServer" Visibility="Collapsed">
                            <TextBlock Text="Port server" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtServerPort" Text="5251" Width="120" HorizontalAlignment="Left" Padding="6"/>
                            <TextBlock Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" Text="Nama PC ini:"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtNamaPcServer" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                <Button x:Name="BtnSalinAlamat" Content="Salin alamat" Padding="10,4" Margin="12,0,0,0" Click="BtnSalinAlamat_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSalinSukses" Text="Alamat disalin - tinggal tempel (paste) di kotak 'Alamat PC server' di PC klien." FontSize="12" Foreground="#059669" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                       Text="Catat nama ini - saat setup PC klien nanti, alamat yang diisi di sana adalah nama ini (bukan alamat IP), yang tidak berubah walau PC dimatikan/dinyalakan ulang."/>
                            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                       Text="Setelah ini, izinkan port di atas masuk lewat Windows Firewall PC ini (Control Panel → Windows Defender Firewall → Pengaturan lanjutan → Inbound Rules → New Rule → Port), supaya PC klien bisa menyambung."/>
                            <TextBlock Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" Text="Alamat Webview-App (opsional - sinkron data siswa)"/>
                            <TextBox x:Name="TxtWebviewApiUrl" Margin="0,4,0,0" Padding="6"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                       Text="Kosongkan kalau belum tahu - bisa diisi belakangan lewat 'Ganti Pengaturan Jaringan'. Setelah diisi, instalasi ini akan minta izin Admin IT sebelum mulai menarik data siswa."/>
                        </StackPanel>
                        <StackPanel x:Name="PanelKlien" Visibility="Collapsed">
                            <TextBlock Text="Alamat PC server di jaringan ini" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtKlienUrl" Text="http://NAMA-PC-SERVER:5251" Padding="6"/>
                            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                       Text="Isi NAMA PC yang sudah diatur sebagai 'Server' (lihat layar 'Nama PC ini' di PC itu), diikuti port-nya - contoh di atas. Pakai nama PC, BUKAN alamat IP."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,24">
            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
            <Button x:Name="BtnLanjut" Content="Lanjutkan" Padding="20,10" FontWeight="SemiBold" Click="BtnLanjut_Click"/>
        </StackPanel>
    </Grid>
</Window>
